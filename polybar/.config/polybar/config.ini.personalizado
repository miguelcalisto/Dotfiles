#ip
[module/public_ip]
type = custom/script
exec = curl -s ifconfig.me
interval = 900

label =  %output%
label-foreground = ${colors.charging}

#temp nativa sem script
[module/temperature]
type = internal/temperature
thermal-zone = 2
warn-temperature = 70

format = <label>
label = "Temp: %temperature%°"
label-foreground = ${colors.charging}

format-warn = <label-warn>
label-warn = "Temp: %temperature%°"
label-warn-foreground = ${colors.alert}

# clima
[module/weather]
type = custom/script
# exec = curl -s "wttr.in/Santa+Maria?format=1" | awk '{print $2}'
exec = curl -s "wttr.in/Silveira+Martins?format=1" | awk '{print $2}'
interval = 600
label = %output%
label-foreground= ${colors.a}


; brilho
[module/brightness]
type = custom/script
exec = bash -c 'b=$(cat /sys/class/backlight/intel_backlight/brightness); m=$(cat /sys/class/backlight/intel_backlight/max_brightness); p=$((b*100/m)); echo "${p}%"'
interval = 5

# label-foreground= ${colors.alert}

label-foreground= ${colors.b}


[module/load]
type = custom/script
#exec = "read a b c d e < /proc/loadavg; echo $a • $d"
exec = "read a b c d e < /proc/loadavg; echo $a • $(echo $d | cut -d'/' -f1)"

interval = 2
label = %output%


