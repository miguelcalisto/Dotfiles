[colors]
background = #282a36
background-alt = #44475a
foreground = #f8f8f2
primary = #bd93f9
secondary = #ffb86c
alert = #ff5555
disabled = #6272a4
low = #FF5555     
medium = #F1FA8C   
high = #50FA7B      
charging = #8BE9FD   
power = #00FF00
a = #FFD700 
b = #89b4fa
xkb-layout-foreground = #a8ffcc
xkb-indicator-foreground = #ff5555
filesystem = #dceeff
xkb-indicator-background = #f7f7df
mode-bg = #aa0000
mode-fg = #ffffff
pulse-prefix = #FFB86C
pulse-volume = #FFB86C
ram = #FF79C6


[bar/example]
bottom = true
width = 100%
height = 24pt
radius = 0

; dpi = 96

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3pt
# borde-seize eh o que tira os espaços  que  mostram o wallpaper de fundo
border-size = 0pt
border-color = #00000000

padding-left = 0
padding-right = 1

module-margin = 1

separator = |
separator-foreground = ${colors.disabled}

font-0 = monospace:style=Bold:pixelsize=12
font-1 = "Hack Nerd Font Mono:style=Bold:size=22;2"

#com xwindow mostra a legenda
#modules-left = xworkspaces xwindow i3
modules-left = xworkspaces i3

modules-right = load brightness weather public_ip wifi network filesystem battery  pulseaudio xkeyboard memory cpu temperature cpu_temp date shutdown


cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true


; tray-position = right

; wm-restack = generic
; wm-restack = bspwm
; wm-restack = i3

; override-redirect = true

[module/xworkspaces]
type = internal/xworkspaces

label-active = %name%
label-active-background = ${colors.background-alt}
label-active-underline= ${colors.primary}
label-active-padding = 1

label-occupied = %name%
label-occupied-padding = 1

label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-padding = 1

label-empty = %name%
label-empty-foreground = ${colors.disabled}
label-empty-padding = 1

[module/xwindow]
type = internal/xwindow
label = %title:0:40:...%


[module/filesystem]
type = internal/fs
interval = 25

mount-0 = /

label-mounted-foreground = ${colors.filesystem} 

label-mounted = %mountpoint% %percentage_used%%

label-unmounted = %mountpoint% not mounted
label-unmounted-foreground = ${colors.disabled}

[module/pulseaudio]
type = internal/pulseaudio

format-volume-prefix = "VOL "
format-volume-prefix-foreground = ${colors.pulse-prefix}
format-volume = <label-volume>

label-volume = %percentage%%
label-volume-foreground = ${colors.pulse-volume}

label-muted = muted
label-muted-foreground = ${colors.disabled}



[module/xkeyboard]
type = internal/xkeyboard
blacklist-0 = num lock
label-indicator-padding = 2
label-indicator-margin = 1

label-indicator-uppercase = true
label-layout = %layout%
label-layout-uppercase = true
label-layout-foreground = ${colors.xkb-layout-foreground}

label-indicator-foreground = ${colors.xkb-indicator-foreground}
label-indicator-background = ${colors.xkb-indicator-background}
#label-indicator-foreground = ${colors.background}
#label-indicator-background = ${colors.secondary}



[module/memory]
type = internal/memory
interval = 2
format-prefix = "RAM "
format-prefix-foreground = ${colors.ram}
label-foreground = ${colors.ram}
label = %percentage_used:2%%


[module/cpu]
type = internal/cpu
interval = 2
format-prefix = "CPU "
format-prefix-foreground = ${colors.medium}
label = %percentage:2%%
label-foreground = ${colors.medium}



[module/network]
type = internal/network
interface = enp1s0
interval = 3
format-connected = <label-connected>
format-disconnected = <label-disconnected>
label-connected = %{F#00FF00} Ethernet%{F-}
label-disconnected = %{F#FF5555} Sem cabo%{F-}



[module/date]
type = internal/date
interval = 1
#date = %A, %d de %B de %Y %{F#fff}%H:%M%{F-}

date = %A, %d %B %Y %{F#fff}%H:%M%{F-}

click-left = 
click-right = 
click-middle =


label = %date%
label-foreground = ${colors.primary}

[module/cpu_temp]
type = custom/script
exec = ~/.config/polybar/scripts/cpu_temp.sh
interval = 1
label = "Temp: %output%"
label-foreground = ${colors.charging}


[module/i3]
type = internal/i3
format = <label-mode>
label-mode = %mode%
label-mode-padding = 1
label-mode-background = ${colors.mode-bg}
label-mode-foreground = ${colors.mode-fg}

[module/shutdown]
type = custom/script
exec = echo "⏻"

label = %output%
label-font = 1
label-foreground = ${colors.power}

click-left = ~/.config/polybar/scripts/shutdown.sh

[settings]
screenchange-reload = true
pseudo-transparency = true

[module/battery]
type = internal/battery
battery = BAT1
adapter = ACAD
full-at = 98

format-charging = %{F#8BE9FD} <label-charging>%{F-}
format-discharging = <ramp-capacity> <label-discharging>
format-full = %{F#50FA7B} <label-full>%{F-}

label-charging = %percentage%%
label-discharging = %percentage%%
label-full = %percentage%%

ramp-capacity-0 = %{F#FF5555}%{F-}
ramp-capacity-1 = %{F#FF5555}%{F-}
ramp-capacity-2 = %{F#F1FA8C}%{F-}
ramp-capacity-3 = %{F#F1FA8C}%{F-}
ramp-capacity-4 = %{F#50FA7B}%{F-}

[module/wifi]
type = internal/network
interface = wlp0s20f3
interval = 3
format-connected = %{F#00bfff} Conectado
format-disconnected = %{F#FF5555}睊 Wi-Fi off%{F-}


